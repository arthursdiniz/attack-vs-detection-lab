<!--
  Attack vs Detection Lab - Custom Wazuh Ruleset
  File: /var/ossec/etc/rules/local_rules.xml
  Author: Senior Detection Engineer
-->
<group name="local,detectlab,">

  <!-- ================================================================= -->
  <!-- INC-001: Authentication Brute Force Detection (T1110.001)         -->
  <!-- ================================================================= -->
  <rule id="100001" level="10" frequency="10" timeframe="60">
    <if_matched_sid>5710, 5716, 5760, 5503, 60122</if_matched_sid>
    <same_srcip />
    <description>DetectLab: High frequency of failed authentications from same source IP (Possible Brute Force / Spray - T1110.001).</description>
    <mitre>
      <id>T1110.001</id>
      <tactic>Credential Access</tactic>
      <technique>Password Guessing</technique>
    </mitre>
    <group>authentication_failed,attack_t1110,</group>
  </rule>

  <rule id="100002" level="13" timeframe="300">
    <if_sid>100001</if_sid>
    <if_matched_sid>5715, 60106</if_matched_sid>
    <same_srcip />
    <description>DetectLab CRITICAL: Successful authentication following a brute-force attack from the same IP (Potential Account Compromise - T1078 / T1110.001).</description>
    <mitre>
      <id>T1078</id>
      <id>T1110.001</id>
      <tactic>Initial Access,Credential Access</tactic>
      <technique>Valid Accounts,Password Guessing</technique>
    </mitre>
    <group>account_compromise,attack_t1078,</group>
  </rule>

  <!-- ================================================================= -->
  <!-- INC-002: Suspicious PowerShell Process Execution (T1059.001)      -->
  <!-- ================================================================= -->
  <rule id="100010" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.commandLine">-enc|-encodedcommand|-w\s+hidden|-windowstyle\s+hidden|-executionpolicy\s+bypass|-ep\s+bypass</field>
    <description>DetectLab: Suspicious PowerShell Process with Encoded or Hidden Execution Flags (T1059.001).</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1562.001</id>
      <tactic>Execution,Defense Evasion</tactic>
      <technique>PowerShell,Impair Defenses</technique>
    </mitre>
    <group>sysmon,powershell_execution,attack_t1059,</group>
  </rule>

  <rule id="100011" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">powershell\.exe|pwsh\.exe</field>
    <field name="win.eventdata.commandLine">\\AppData\\Local\\Temp|\\Users\\Public|C:\\Windows\\Temp</field>
    <description>DetectLab: PowerShell Execution Staged from User-Writable Directory (T1059.001 / T1027).</description>
    <mitre>
      <id>T1059.001</id>
      <tactic>Execution</tactic>
      <technique>PowerShell</technique>
    </mitre>
    <group>sysmon,staging_execution,</group>
  </rule>

  <!-- ================================================================= -->
  <!-- INC-003: Account Creation & Group Elevation Correlation (T1136)   -->
  <!-- ================================================================= -->
  <rule id="100020" level="6">
    <if_sid>60109</if_sid> <!-- Standard Windows Event 4720 sid in Wazuh -->
    <description>DetectLab: A new local user account was created (Event ID 4720 - T1136.001).</description>
    <mitre>
      <id>T1136.001</id>
      <tactic>Persistence</tactic>
      <technique>Local Account</technique>
    </mitre>
    <group>account_creation,</group>
  </rule>

  <rule id="100021" level="8">
    <if_sid>60144</if_sid> <!-- Standard Windows Event 4732 / 4728 in Wazuh -->
    <field name="win.eventdata.targetUserName">^Administrators$|^Administradores$</field>
    <description>DetectLab: A user was added to the local Administrators security group (T1098).</description>
    <mitre>
      <id>T1098</id>
      <tactic>Privilege Escalation,Persistence</tactic>
      <technique>Account Manipulation</technique>
    </mitre>
    <group>group_elevation,</group>
  </rule>

  <rule id="100022" level="12" timeframe="120">
    <if_sid>100020</if_sid>
    <if_matched_sid>100021</if_matched_sid>
    <description>DetectLab CRITICAL: Newly created user added to local Administrators group within 120s (T1136.001 / T1098).</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1098</id>
      <tactic>Persistence,Privilege Escalation</tactic>
      <technique>Local Account,Account Manipulation</technique>
    </mitre>
    <group>privilege_escalation_correlation,</group>
  </rule>

  <!-- ================================================================= -->
  <!-- INC-004: Critical File Modification (FIM - T1565.001)             -->
  <!-- ================================================================= -->
  <rule id="100030" level="10">
    <if_sid>550</if_sid>
    <field name="file">/etc/passwd$|/etc/shadow$|/etc/sudoers$|sensitive-config\.txt$|drivers/etc/hosts$</field>
    <description>DetectLab HIGH: Critical file integrity checksum mismatch in watched system file (T1565.001).</description>
    <mitre>
      <id>T1565.001</id>
      <tactic>Impact,Defense Evasion</tactic>
      <technique>Stored Data Manipulation</technique>
    </mitre>
    <group>syscheck,critical_file_tampering,</group>
  </rule>

  <!-- ================================================================= -->
  <!-- INC-005: Suspicious System Discovery Burst (T1082 / T1087 / T1016)-->
  <!-- ================================================================= -->
  <rule id="100040" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image">whoami\.exe|net\.exe|net1\.exe|ipconfig\.exe|netstat\.exe|systeminfo\.exe|tasklist\.exe|route\.exe|nltest\.exe</field>
    <description>DetectLab: Reconnaissance / System Discovery command executed (T1082 / T1087.001 / T1016).</description>
    <mitre>
      <id>T1082</id>
      <id>T1087.001</id>
      <id>T1016</id>
      <tactic>Discovery</tactic>
      <technique>System Information Discovery</technique>
    </mitre>
    <group>sysmon,discovery_command,</group>
  </rule>

  <rule id="100041" level="10" frequency="5" timeframe="30">
    <if_matched_sid>100040</if_matched_sid>
    <description>DetectLab: High-frequency burst of system discovery commands (T1082 / T1087.001 / T1016).</description>
    <mitre>
      <id>T1082</id>
      <id>T1087.001</id>
      <id>T1016</id>
      <tactic>Discovery</tactic>
      <technique>System Information Discovery</technique>
    </mitre>
    <group>discovery_burst,</group>
  </rule>

</group>
